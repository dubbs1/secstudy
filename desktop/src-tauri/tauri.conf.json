{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AWS CP Study",
  "mainBinaryName": "aws-cp-study",
  "version": "1.1.0",
  "identifier": "app.secstudy.awscp",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "AWS Cloud Practitioner study tool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
